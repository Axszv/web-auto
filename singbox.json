{
  "log": {
    "level": "warn"
  },
  "inbounds": [
    {
      "type": "http",
      "tag": "http-in",
      "listen": "127.0.0.1",
      "listen_port": 1080
    }
  ],
  "outbounds": [
    {
      "type": "vless",
      "tag": "vless-out",
      "server": "{{PROXY_SERVER}}",
      "server_port": 443,
      "uuid": "REDACTED",
      "tls": {
        "enabled": true,
        "server_name": "REDACTED-HOST"
      },
      "transport": {
        "type": "ws",
        "path": "/?ed=2560",
        "headers": {
          "Host": "REDACTED-HOST"
        }
      }
    },
    {
      "type": "direct",
      "tag": "direct"
    }
  ],
  "route": {
    "final": "vless-out"
  }
}
